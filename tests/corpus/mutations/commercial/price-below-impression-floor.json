{
  "format": "banner",
  "protocol": "ortb-2.5",
  "context": "web",
  "dialect": "iab",
  "reference": {
    "wireProtocol": "openrtb-2.5",
    "vendorDialect": "iab",
    "validity": "valid",
    "pairApplicability": {
      "kind": "bid-pair",
      "note": "Every response bid references an offered impression/item; auction identifiers match."
    },
    "sourceIds": ["banner-native:bn-ortb25", "banner-native:bn-ortb26"],
    "archiveSha256": "b5299ee8e072231bdc3f8334231efd7ad5ae12418a43fddba70d29b5afd146d7"
  },
  "assetRefs": [],
  "kind": "mutation",
  "id": "price-below-impression-floor",
  "title": "A below-floor bid is structurally valid but loses the impression",
  "scenario": "pair",
  "tags": ["mutation", "commercial"],
  "base": "bn-banner-25-fixed",
  "category": "commercial",
  "specRef": "https://github.com/InteractiveAdvertisingBureau/openrtb2.x/blob/403cbba542de3a5d9cfcccd0a34e74b01b79a9f1/2.6.md#objectbid",
  "patch": {
    "response": [
      {
        "op": "replace",
        "path": "/seatbid/0/bid/0/price",
        "value": 0.1
      }
    ]
  },
  "expect": {
    "request": {
      "maxLevel": "warning"
    },
    "response": {
      "maxLevel": "warning",
      "must": [
        {
          "id": "err-bid-price-below-floor",
          "path": "seatbid[0].bid[0].price",
          "level": "warning"
        }
      ]
    },
    "crosscheck": {
      "must": [
        {
          "id": "crosscheck.bid.below_floor",
          "path": "seatbid[0].bid[0].price",
          "level": "warn"
        }
      ],
      "mustNot": [
        {
          "id": "crosscheck.bid.above_floor",
          "path": "seatbid[0].bid[0].price"
        }
      ]
    },
    "http": {
      "status": 200
    },
    "browser": {
      "state": "success"
    }
  },
  "knownGap": null,
  "specNotes": []
}
