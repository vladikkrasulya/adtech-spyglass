  "id": "field-shape-regs-coppa-invalid",
  "title": "regs.coppa outside 0/1 is not a boolean flag the spec defines",
  "scenario": "pair",
  "tags": ["mutation", "field-shape"],
  "base": "bn-banner-25-fixed",
  "category": "field-shape",
  "specRef": "https://github.com/InteractiveAdvertisingBureau/openrtb2.x/blob/403cbba542de3a5d9cfcccd0a34e74b01b79a9f1/2.6.md#objectregs",
  "patch": {
    "request": [
      {
        "op": "add",
        "path": "/regs",
        "value": {
          "coppa": 2
        }
      }
    ]
  },
  "expect": {
    "request": {
      "mustIssueAt": ["regs.coppa"]
    },
    "response": {
      "maxLevel": "warning"
    },
    "crosscheck": {
      "must": [
        {
          "id": "crosscheck.id_match",
          "path": "id",
          "level": "ok"
        },
        {
          "id": "crosscheck.bid.impid_resolved",
          "path": "seatbid[0].bid[0].impid",
          "level": "ok"
        },
        {
          "id": "crosscheck.bid.above_floor",
          "path": "seatbid[0].bid[0].price",
          "level": "ok"
        },
        {
          "id": "crosscheck.bid.size_match",
          "path": "seatbid[0].bid[0].size",
          "level": "ok"
        }
      ]
    },
    "http": {
      "status": 200
    },
    "browser": {
      "state": "success"
    }
  },
  "specNotes": [
    "packages/core/crosscheck.js never reads regs.coppa, so this is a request-validation-only gap; the crosscheck and response findings are identical to the unmodified base pair.",
