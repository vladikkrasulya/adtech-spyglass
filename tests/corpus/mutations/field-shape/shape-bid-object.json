  "kind": "mutation",
  "id": "shape-bid-object",
  "title": "Malformed bid-object retains structured validation output",
  "scenario": "pair",
  "tags": ["mutation", "field-shape"],
  "base": "bn-banner-25-fixed",
  "category": "field-shape",
  "specRef": "https://github.com/InteractiveAdvertisingBureau/openrtb2.x/blob/403cbba542de3a5d9cfcccd0a34e74b01b79a9f1/2.6.md#objectbid",
  "patch": {
    "response": [
      {
        "op": "replace",
        "path": "/seatbid/0/bid",
        "value": {}
      }
    ]
  },
  "expect": {
    "request": {
      "maxLevel": "warning"
    },
    "response": {
      "status": "errors",
      "must": [
        {
          "id": "response.seatbid.empty",
          "path": "seatbid[0].bid",
          "level": "error"
        }
      ]
    },
    "crosscheck": {
      "mustNot": [
        {
          "id": "crosscheck.bid.above_floor",
          "path": "seatbid[0].bid[0].price"
        }
      ]
    },
    "http": {
      "status": 200
    },
    "browser": {
      "state": "success"
    }
  },
  "knownGap": {
    "id": "DEF-115",
    "layers": ["http", "browser"],
    "note": "Syntactically valid JSON containing malformed nested field types should retain structured validation findings and HTTP success envelope; internal forEach failures must not replace them with bad_request.",
    "matches": {
      "http": [
        "^http:\\ expected\\ 200,\\ got\\ 400\\ \\{\"success\":false,\"error\":\"\\(intermediate\\ value\\)\\(intermediate\\ value\\)\\(intermediate\\ value\\)\\.forEach\\ is\\ not\\ a\\ function\",\"code\":\"bad_request\"\\}$"
      ],
      "browser": [
        "^browser\\.state:\\ expected\\ success,\\ got\\ failed$",
        "^browser\\.console:\\ Analysis\\ error:\\ TypeError:\\ Cannot\\ read\\ properties\\ of\\ undefined\\ \\(reading\\ 'cur'\\)$"
      ]
    }
  },
  "specNotes": []
