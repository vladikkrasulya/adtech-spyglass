{
  "format": "banner",
  "protocol": "ortb-2.5",
  "context": "web",
  "dialect": "iab",
  "reference": {
    "wireProtocol": "openrtb-2.5",
    "vendorDialect": "iab",
    "validity": "valid",
    "pairApplicability": {
      "kind": "bid-pair",
      "note": "Every response bid references an offered impression/item; auction identifiers match."
    },
    "sourceIds": ["banner-native:bn-ortb25", "banner-native:bn-ortb26"],
    "archiveSha256": "b5299ee8e072231bdc3f8334231efd7ad5ae12418a43fddba70d29b5afd146d7"
  },
  "assetRefs": [],
  "kind": "mutation",
  "id": "field-shape-imp-missing",
  "title": "A BidRequest without any imp array cannot be crosschecked against its response",
  "scenario": "pair",
  "tags": ["mutation", "field-shape"],
  "base": "bn-banner-25-fixed",
  "category": "field-shape",
  "specRef": "https://github.com/InteractiveAdvertisingBureau/openrtb2.x/blob/403cbba542de3a5d9cfcccd0a34e74b01b79a9f1/2.6.md#objectbidrequest",
  "patch": {
    "request": [{ "op": "remove", "path": "/imp" }]
  },
  "expect": {
    "request": {
      "status": "errors",
      "must": [{ "id": "request.imp_required", "path": "imp", "level": "error" }]
    },
    "response": {
      "maxLevel": "warning"
    },
    "crosscheck": {
      "must": [{ "id": "crosscheck.no_request", "path": "req", "level": "crit" }],
      "mustNot": [
        { "id": "crosscheck.id_match", "path": "id" },
        { "id": "crosscheck.bid.impid_resolved" },
        { "id": "crosscheck.bid.impid_unresolved" },
        { "id": "crosscheck.bid.above_floor" },
        { "id": "crosscheck.bid.size_match" },
        { "id": "crosscheck.auction.summary" }
      ]
    },
    "http": {
      "status": 200
    },
    "browser": {
      "state": "success"
    }
  },
  "knownGap": null,
  "specNotes": [
    "Without an imp array the request view cannot be built at all (imp must be an array per §3.2.1); crosscheck reports a single no_request finding instead of per-bid resolution."
  ]
}
