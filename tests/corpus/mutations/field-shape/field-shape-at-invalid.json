{
  "format": "banner",
  "protocol": "ortb-2.5",
  "context": "web",
  "dialect": "iab",
  "reference": {
    "wireProtocol": "openrtb-2.5",
    "vendorDialect": "iab",
    "validity": "valid",
    "pairApplicability": {
      "kind": "bid-pair",
      "note": "Every response bid references an offered impression/item; auction identifiers match."
    },
    "sourceIds": ["banner-native:bn-ortb25", "banner-native:bn-ortb26"],
    "archiveSha256": "b5299ee8e072231bdc3f8334231efd7ad5ae12418a43fddba70d29b5afd146d7"
  },
  "assetRefs": [],
  "kind": "mutation",
  "id": "field-shape-at-invalid",
  "title": "Auction type 0 is not a value the spec or exchange range defines",
  "scenario": "pair",
  "tags": ["mutation", "field-shape"],
  "base": "bn-banner-25-fixed",
  "category": "field-shape",
  "specRef": "https://github.com/InteractiveAdvertisingBureau/openrtb2.x/blob/403cbba542de3a5d9cfcccd0a34e74b01b79a9f1/2.6.md#objectbidrequest",
  "patch": {
    "request": [{ "op": "replace", "path": "/at", "value": 0 }]
  },
  "expect": {
    "request": {
      "maxLevel": "warning",
      "must": [{ "id": "request.at_invalid", "path": "at", "level": "warning" }],
      "mustNot": [{ "id": "request.at_required" }]
    },
    "response": {
      "maxLevel": "warning"
    },
    "crosscheck": {
      "must": [
        { "id": "crosscheck.id_match", "path": "id", "level": "ok" },
        {
          "id": "crosscheck.bid.impid_resolved",
          "path": "seatbid[0].bid[0].impid",
          "level": "ok"
        },
        {
          "id": "crosscheck.bid.above_floor",
          "path": "seatbid[0].bid[0].price",
          "level": "ok"
        },
        { "id": "crosscheck.bid.size_match", "path": "seatbid[0].bid[0].size", "level": "ok" }
      ]
    },
    "http": {
      "status": 200
    },
    "browser": {
      "state": "success"
    }
  },
  "knownGap": null,
  "specNotes": [
    "OpenRTB 2.6 §3.2.1 at: 1=First Price, 2=Second Price Plus; values >=500 are reserved for exchange-specific auction models. 0 is neither, so this is a WARNING (non-standard), not an ERROR."
  ]
}
