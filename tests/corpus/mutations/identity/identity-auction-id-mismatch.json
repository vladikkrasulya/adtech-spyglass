  "kind": "mutation",
  "id": "identity-auction-id-mismatch",
  "title": "A response for another auction cannot match the request",
  "scenario": "pair",
  "tags": ["mutation", "identity"],
  "base": "bn-banner-25-fixed",
  "category": "identity",
  "specRef": "https://github.com/InteractiveAdvertisingBureau/openrtb2.x/blob/403cbba542de3a5d9cfcccd0a34e74b01b79a9f1/2.6.md#objectbidresponse",
  "patch": {
    "response": [
      {
        "op": "replace",
