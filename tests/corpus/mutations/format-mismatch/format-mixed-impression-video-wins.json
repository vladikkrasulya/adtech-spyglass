  "id": "format-mixed-impression-video-wins",
  "title": "A video bid on mixed inventory is not checked against unchosen banner/native assets",
  "scenario": "pair",
  "tags": ["mutation", "format-mismatch"],
  "base": "video-web-26-companion-vast3",
  "category": "format-mismatch",
