        "^browser\\.crosscheck:\\ forbidden\\ crosscheck\\.bid\\.size_mismatch\\ @\\ seatbid\\[0\\]\\.bid\\[0\\]\\.size\\ →\\ crosscheck\\.bid\\.size_mismatch\\[warn\\]@seatbid\\[0\\]\\.bid\\[0\\]\\.size$",
