  "patch": {
    "replaceRequest": {
      "id": "video-web-26-companion-vast3",
      "test": 1,
      "at": 1,
      "tmax": 500,
      "cur": ["USD"],
      "imp": [
        {
          "id": "video-1",
          "secure": 1,
          "bidfloor": 1,
          "bidfloorcur": "USD",
          "video": {
            "mimes": ["video/mp4"],
            "minduration": 5,
            "maxduration": 30,
            "protocols": [3],
            "w": 640,
            "h": 480,
            "linearity": 1,
            "plcmt": 1,
            "startdelay": 0,
            "minbitrate": 300,
            "maxbitrate": 1500,
            "delivery": [2],
            "playbackmethod": [3],
            "battr": [13, 14],
            "companionad": [
              {
                "id": "companion-1",
                "w": 300,
                "h": 250,
                "mimes": ["image/svg+xml"],
                "battr": [13, 14]
              }
            ],
            "companiontype": [1]
          },
          "banner": {
            "w": 300,
            "h": 250
          },
          "native": {
            "ver": "1.2",
            "request": "{\"ver\": \"1.2\", \"assets\": [{\"id\": 1, \"required\": 1, \"title\": {\"len\": 60}}]}"
          }
        }
      ],
      "site": {
        "id": "fixture-site",
        "domain": "publisher.example.test",
        "page": "https://publisher.example.test/content",
        "publisher": {
          "id": "fixture-publisher"
        }
      },
      "device": {
        "ua": "Mozilla/5.0 (Synthetic fixture; audit)",
        "devicetype": 2,
        "language": "en",
        "ip": "192.0.2.11",
        "os": "Linux",
        "osv": "6.1"
      }
    }
  },
  "expect": {
    "request": {
      "maxLevel": "warning"
    },
    "response": {
      "maxLevel": "warning"
    },
    "crosscheck": {
      "must": [
        {
          "id": "crosscheck.bid.video_vast",
          "path": "seatbid[0].bid[0].adm",
          "level": "ok"
        }
      ],
      "mustNot": [
        {
          "id": "crosscheck.bid.size_mismatch",
          "path": "seatbid[0].bid[0].size"
        },
        {
          "id": "crosscheck.bid.native_invalid_adm",
          "path": "seatbid[0].bid[0].adm"
        }
      ]
    },
    "http": {
      "status": 200
    },
    "browser": {
      "state": "success"
    }
  },
