  "expect": {
    "request": {
      "maxLevel": "warning"
    },
    "response": {
      "maxLevel": "warning"
    },
    "crosscheck": {
      "must": [
        {
          "id": "crosscheck.id_match",
          "path": "id",
          "level": "ok"
        },
        {
          "id": "crosscheck.bid.impid_resolved",
          "path": "seatbid[0].bid[0].impid",
          "level": "ok"
        },
        {
          "id": "crosscheck.bid.above_floor",
          "path": "seatbid[0].bid[0].price",
          "level": "ok",
          "params": {
            "floor": "0.2000"
          }
        },
        {
          "id": "crosscheck.bid.size_match",
          "path": "seatbid[0].bid[0].size",
          "level": "ok"
        }
      ],
      "mustNot": [
        "crosscheck.id_mismatch",
        "crosscheck.bid.impid_unresolved",
        "crosscheck.bid.native_missing_assets",
        "crosscheck.bid.native_invalid_adm"
      ]
    },
    "format": {
      "formats": ["banner"],
      "contexts": ["web"]
    },
    "http": {
      "status": 200
    },
    "browser": {
      "state": "success"
    }
  },
  "knownGap": null,
  "specNotes": [
    "The nesting is 50 levels of {\"nNN\": {...}} ending in {\"marker\":\"deep-ext-50\"}, well under packages/core/raw-json.js DEFAULT_LIMITS.maxDepth (512) and under every recursion path Core actually walks (none of which descend into ext at all).",
    "This is a robustness/no-crash assertion, mirroring the existing encoding-large-ext-string.json case for a large (wide) ext value rather than a deep one."
  ]
}
