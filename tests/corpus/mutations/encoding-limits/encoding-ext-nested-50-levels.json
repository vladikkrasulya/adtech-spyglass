{
  "kind": "mutation",
  "id": "encoding-ext-nested-50-levels",
  "format": "banner",
  "protocol": "ortb-2.5",
  "context": "web",
  "dialect": "iab",
  "base": "bn-banner-25-fixed",
  "category": "encoding-limits",
  "scenario": "pair",
  "tags": ["mutation", "encoding-limits"],
  "title": "a 50-level deep nested ext object is processed without error or truncation",
  "specRef": "https://github.com/InteractiveAdvertisingBureau/openrtb2.x/blob/403cbba542de3a5d9cfcccd0a34e74b01b79a9f1/2.6.md#objectbidrequest §3.1 — ext is the open vendor-extension surface at every object level; packages/core/unknown-fields.js documents \"ext is never inspected — not the key, not one level of its subtree\", so nesting inside it is opaque to every unknown-field and structural rule.",
  "patch": {
    "request": [
      {
        "op": "add",
        "path": "/ext",
        "value": {
          "n0": {
            "n1": {
              "n2": {
