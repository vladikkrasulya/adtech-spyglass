  "tags": ["mutation", "encoding-limits"],
  "base": "bn-banner-25-fixed",
  "category": "encoding-limits",
  "specRef": "https://www.rfc-editor.org/rfc/rfc8259#section-4",
  "patch": {
    "rawResponse": "{\"id\":\"bn-banner-25-fixed\",\"cur\":\"USD\",\"seatbid\":[{\"seat\":\"synthetic-seat-a\",\"bid\":[{\"id\":\"bid-fixed\",\"impid\":\"slot-1\",\"price\":1.25,\"price\":1.25,\"adm\":\"<!doctype html><html><head><meta charset=\\\"utf-8\\\"><style>html,body{margin:0}.ad{position:relative;width:300px;height:250px;overflow:hidden;font-family:Arial,sans-serif;background:#223b62}img{display:block;width:100%;height:100%}.label{position:absolute;top:8px;left:8px;background:#fff;color:#162d49;padding:4px 7px;border-radius:4px;font-size:12px}</style></head><body><div class=\\\"ad\\\" data-fixture=\\\"BANNER FIXED\\\" role=\\\"img\\\" aria-label=\\\"BANNER FIXED\\\"><img alt=\\\"BANNER FIXED landscape\\\" src=\\\"data:image/svg+xml;base64,\\\"><span class=\\\"label\\\">BANNER FIXED \\u00b7 TEST AD</span></div></body></html>\",\"adomain\":[\"advertiser.example.test\"],\"crid\":\"bid-fixed-creative\",\"w\":300,\"h\":250}]}]}"
  },
  "expect": {
    "request": {
      "maxLevel": "warning"
    },
    "response": {
      "status": "errors",
      "must": [
        {
          "id": "payload.duplicate_key",
          "path": "seatbid[0].bid[0].price",
          "level": "error"
