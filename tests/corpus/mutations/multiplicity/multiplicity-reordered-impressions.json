  "patch": {
    "replaceRequest": {
      "id": "bn-banner-26-multiimp-multiseat",
      "test": 1,
      "at": 2,
      "tmax": 800,
      "cur": ["USD"],
      "imp": [
        {
          "id": "rail",
          "secure": 1,
          "bidfloor": 0.2,
          "bidfloorcur": "USD",
          "banner": {
            "format": [
              {
                "w": 160,
                "h": 600
              }
            ]
          }
        },
        {
          "id": "top",
          "secure": 1,
          "bidfloor": 0.2,
          "bidfloorcur": "USD",
          "banner": {
            "format": [
              {
                "w": 728,
                "h": 90
              }
            ]
          },
          "rwdd": 0
        }
      ],
      "device": {
        "ua": "Mozilla/5.0 (Synthetic fixture; audit)",
        "devicetype": 2,
        "language": "en",
        "ip": "192.0.2.11",
        "os": "Linux",
        "osv": "6.1"
      },
      "site": {
        "id": "synthetic-site",
        "domain": "publisher.example.test",
        "page": "https://publisher.example.test/audit",
        "publisher": {
          "id": "synthetic-publisher"
        }
      }
    }
  },
  "expect": {
    "request": {
      "maxLevel": "warning"
    },
    "response": {
      "maxLevel": "warning"
    },
    "crosscheck": {
      "must": [
        {
          "id": "crosscheck.id_match",
