#!/bin/bash
# Pre-push hook: runs the local repository gate before any push that updates main.
# Hosted CI additionally owns its package and Docker smoke jobs. Never bypass a
# failing local or hosted gate.
#
# Enable once per clone: `git config core.hooksPath .githooks`

set -e

# Git supplies every proposed ref update on stdin as:
#   <local ref> <local object> <remote ref> <remote object>
# The destination ref is the security boundary: feature:main and HEAD:main
# require the same gate as main:main, while main:feature does not.
updates_main=0
while read -r _local_ref _local_oid remote_ref _remote_oid; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    updates_main=1
  fi
done

if [ "$updates_main" -ne 1 ]; then
  echo "[pre-push] no update to refs/heads/main — skipping CI checks"
  exit 0
fi

echo "[pre-push] running the local repository gate: npm run ci…"
echo "           hosted CI will additionally run package and Docker smoke jobs."
echo

# Run the unified ci script. Fails fast on first error.
npm run ci

echo
echo "[pre-push] all green — pushing."
