# ortbtools runtime configuration.
#
# Copy this file to .env (which is git-ignored) and fill in real values for
# anything the running container actually needs. Keep .env.example up-to-date
# with EVERY variable the codebase reads, even if no value is committed.
#
# Convention: server-side env vars are ORTBTOOLS_* prefixed. Build-time / public
# vars use ORTBTOOLS_PUBLIC_* and may be embedded in client bundles.

# ── Runtime ───────────────────────────────────────────────────
# Listen port inside the container (compose maps host :8090 → container :3000).
# ORTBTOOLS_PORT=3000

# Filesystem path to SQLite DB inside the container. Comes from the host
# /srv/DATA/AppData/ortbtools/ volume. Don't change unless you also update
# docker-compose.yml volume mapping.
# ORTBTOOLS_DATA_DIR=/data

# ── Immutable image / deploy state (v1.1.5+) ──────────────────
# Deployed image tag — written atomically by scripts/deploy.sh and auto-read by
# docker-compose.yml `image: ortbtools:${ORTBTOOLS_TAG}`. Compose REQUIRES a
# non-empty value (`:?` guard) so a plain `docker compose up -d` / reboot re-runs
# the exact deployed image and NEVER falls back to a local/dev one. Left EMPTY
# here on purpose: an un-provisioned env must FAIL the compose guard, not silently
# run something. Never edit by hand; use scripts/deploy.sh or scripts/rollback.sh.
ORTBTOOLS_TAG=

# Blog content root inside the container. In production this points at a
# persistent subdir of the /data volume so promoted posts survive recreate and
# stay out of the git working tree + the image layer. Default (unset) = the
# baked seed at /app/content/posts (used by tests + dev).
CONTENT_DIR=/data/content-posts

# ── Phase 7 — auth (NOT IN USE YET) ───────────────────────────
# When multi-user auth lands, these become required. Keep commented until then.
#
# 32+ random bytes hex; rotate periodically. Generate with:
#   openssl rand -hex 32
# ORTBTOOLS_SESSION_SECRET=
#
# Bcrypt-hashed admin password (only relevant if running standalone, not behind
# the kyivtech-portal proxy which already provides auth).
# ORTBTOOLS_ADMIN_PASSWORD_HASH=

# ── Phase 5 — public deploy split (NOT IN USE YET) ────────────
# Build target: 'private' (auth'd workspace) or 'public' (demo, no library).
# Default: private. Public build strips the library UI at compile time.
# ORTBTOOLS_BUILD_TARGET=private

# ── Phase 8 — transactional email + password reset (REQUIRED in prod) ──
# Without these set, email-related features short-circuit to console-log
# (development fallback). In production set NODE_ENV=production AND fill these.
NODE_ENV=production

# Resend API key — from https://resend.com/api-keys (required in prod).
# Domain must be verified in Resend before sends will succeed (DKIM via
# Cloudflare TXT record on kyivtech.com.ua, ~5 min to propagate).
RESEND_API_KEY=

# From-address used in transactional emails. MUST be on a domain verified
# in Resend; otherwise the API rejects with 403.
EMAIL_FROM=ortbtools@kyivtech.com.ua

# HMAC secret for stateless email-verify / password-reset tokens.
# Generate with: openssl rand -hex 32
# Rotating this invalidates ALL outstanding tokens (acceptable, rare).
EMAIL_TOKEN_SECRET=

# Public origin used in email links. NO trailing slash.
PUBLIC_BASE_URL=https://ortbtools.com

# ── Admin alerts via Telegram (optional) ──────────────────────
# When BOTH are set, server-side errors (email-send failures, uncaught
# exceptions, 5xx in handlers) ping the admin chat. Missing either var
# disables the channel cleanly — events still log to stderr.
# Bot token from BotFather; chat_id from /start'ing the bot then
# `curl https://api.telegram.org/bot<TOKEN>/getUpdates`.
TG_BOT_TOKEN=
TG_ADMIN_CHAT_ID=

# ── Server-side error tracking (optional) ────────────────────────
# Any Sentry-compatible DSN (including self-hosted GlitchTip). /api/health
# reports sentry.ready=true only when the SDK accepts a valid parsed DSN; it
# does not probe upstream connectivity. Unset/invalid disables capture locally;
# Telegram alerts remain independent.
SENTRY_DSN=

# ── Admin stats endpoint (optional) ──────────────────────────────
# Bearer token for GET /api/admin/stats (optional monitoring/automation
# consumers). 32+ random hex bytes, e.g. `openssl rand -hex 24`.
# Without it the endpoint returns 503; nothing else breaks.
ADMIN_STATS_TOKEN=

# ── ClickHouse analytics (event-log, validation-log, news pipeline) ──
# HTTP endpoint + creds for the analytics.* tables (lib/clickhouse.js). Without
# URL+USER, every CH-backed feature (event log, validation log, news crawler
# and blog moderator) cleanly no-ops.
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
# Set to 1 to disable validation_logs + event_log + product telemetry even when
# CLICKHOUSE_USER is set.
# Per-user SQLite analyze_log (Cabinet activity) is unaffected. See docs/PRIVACY.md.
ORTBTOOLS_ANALYTICS_DISABLED=

# ── Shareable encrypted gists (modules/gists/handler.js) ─────────
# Overflow path for share links whose payload will not fit a URL fragment. The
# browser compresses and encrypts the bundle and keeps the key in the fragment,
# so the server stores ciphertext it has no way to read. Nothing to configure to
# turn it on; these only tune the bounds.
#
# How long a share link stays readable. Default 30, clamped to 1..365.
# ORTBTOOLS_GIST_TTL_DAYS=30
# Share links created per minute per IP. Creation is anonymous by design, so
# this is the main brake on abuse (default 10).
# GIST_WRITE_MAX_PER_WINDOW=10

# ── Product telemetry (lib/product-telemetry.js) ─────────────────
# Anonymous counters that separate real external users from owner, agent, CI,
# monitoring and crawler traffic, so activation / repeat usage / D1-D7-D30
# retention are computable. Stores no payload, no IP and no User-Agent string.
# Table DDL + analysis SQL: docs/OPERATIONS.md §4.10. Contract: docs/PRIVACY.md.
#
# APP-WIDE client-address rule (lib/client-ip.js) — auth.clientIp() delegates to
# it, so this governs every per-IP rate limiter (login, analyze, intel, stream
# SSE, sentry-ingest), the recorded IP in event_log/sessions, AND product
# telemetry's external-vs-internal split.
#
# The published port (127.0.0.1:8090 -> 3000) makes Docker's userland proxy
# re-originate every connection, so the container's TCP peer is the bridge
# GATEWAY, never loopback. Leave this unset behind such a proxy and the forwarded
# header is discarded: every visitor resolves to the SAME private address, which
# collapses all per-IP limiters into one shared bucket and files every real user
# as `internal`. Set it to the peer the app actually sees:
#   docker exec clickhouse clickhouse-client -q \
#     "SELECT ip, count() FROM analytics.ortbtools_events \
#      WHERE ts >= now() - INTERVAL 1 DAY GROUP BY ip ORDER BY 2 DESC"
# Comma-separated: exact IPv4, IPv4 CIDR, or a literal IPv6. Loopback is always
# trusted. Empty means "trust nothing but loopback" — the safe default for a
# self-host that terminates TLS in-process.
ORTBTOOLS_TRUSTED_PROXIES=

# Kill switch for JUST this table (validation_logs + event_log keep running):
ORTBTOOLS_PRODUCT_TELEMETRY_DISABLED=
# Requests from these addresses are filed as `owner`, never as external users.
# Comma-separated: exact IPv4, IPv4 CIDR, or a literal IPv6 address.
# ORTBTOOLS_OWNER_IPS=203.0.113.45,198.51.100.0/24
# Signed-in accounts that are the operator's own. Comma-separated user ids.
# ORTBTOOLS_OWNER_USER_IDS=1
# Per-IP cap on the telemetry beacon (default 120/min/IP).
# TELEMETRY_MAX_PER_WINDOW=120

# ── Blog moderator + translation (lib/news-moderator.js) ─────────
# Relevance scoring is deterministic and local to the app. EN→UK/RU translation
# runs through OpenRouter and is REQUIRED for auto-publishing; without it,
# drafts above the relevance threshold remain pending for manual review.
OPENROUTER_API_KEY=
# OpenRouter model for EN→UK/RU translation (non-reasoning DeepSeek is cheap).
# OPENROUTER_MODEL=deepseek/deepseek-chat
# Auto-publish guardrails (defaults shown):
# BLOG_MAX_PER_DAY=3
# BLOG_RELEVANCE_MIN=8
# BLOG_MODERATE_BATCH=8

# ── Dialect labeller (modules/ai-label) ──────────────────────────────────
# Local ollama on the host. docker-compose.yml sets this to the host-gateway
# alias; override only for local development outside docker.
# The model name is NOT configurable — see lib/ollama.js for why.
# OLLAMA_URL=http://localhost:11434
#
# Ceiling for one labelling call. The shared runner handles one request at a
# time, so a call can queue behind another fleet service before its own ~2s of
# inference begins. Raise if the box gets busier.
# OLLAMA_TIMEOUT_MS=20000
