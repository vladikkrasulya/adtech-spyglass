{
  "name": "ortbtools",
  "version": "1.14.5",
  "description": "OpenRTB inspector — paste a BidRequest/BidResponse, get human-readable validation, semantic crosscheck, creative preview.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node scripts/run-tests.js",
    "test:watch": "ORTBTOOLS_DATA_DIR=$(mktemp -d -t ortbtools-test-XXXXXX) NODE_ENV=test LOG_LEVEL=silent node --test --watch tests/*.test.js",
    "test:coverage": "node scripts/run-tests.js --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "test:browser": "node --test --test-concurrency=1 $(grep -rl puppeteer tests/*.test.js)"
  },
  "dependencies": {
    "@ortbtools/core": "*",
    "@sentry/node": "^10.70.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.5.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "dompurify": "3.4.13",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "marked": "15.0.12",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.4",
    "puppeteer-core": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
